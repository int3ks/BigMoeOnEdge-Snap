--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1368,6 +1368,17 @@ void llama_context::attach_threadpool(
 void llama_context::detach_threadpool() {
     LLAMA_LOG_DEBUG("%s: call\n", __func__);
 
+    // bmoe: the CPU backend keeps the pool it computed with last and pauses it on the next switch. A caller that
+    // frees its pools after detaching (to build new ones with other thread counts or cores) left it a dangling
+    // pointer: the next graph paused freed memory (hang or crash). Let go of it while it still exists.
+    if (backend_cpu != nullptr) {
+        auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend_cpu));
+        auto * set_threadpool_fn = (decltype(ggml_backend_cpu_set_threadpool) *) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool");
+        if (set_threadpool_fn) {
+            set_threadpool_fn(backend_cpu, nullptr);
+        }
+    }
+
     this->threadpool       = nullptr;
     this->threadpool_batch = nullptr;
 }
