<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Explicitly used only for two opt-in workflows: "Register path (no copy)" for GGUF files and the shared
         workspace folder (Settings → Workspace). On Android 11+, direct absolute paths in shared storage
         require special all-files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10 compatibility for direct paths; Android 11+ uses MANAGE_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- In-app update (Settings → App update): hands a downloaded release APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- run_shell (Settings → Tools → Termux): hands commands to the separately installed Termux app through its
         RUN_COMMAND intent. A runtime permission that Termux defines; the user grants it in the Termux section. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- Offline dictation into the message box (speech/Dictation.kt), on-device recognizer only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ package visibility: lets the app see whether Termux is installed. -->
    <queries>
        <package android:name="com.termux" />
        <!-- Speech recognizers and text-to-speech engines (speech/): without these Android 11+ hides them. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>


    <!-- appCategory is a performance hint, not a claim about what the app is. The reference app
         (BigMoeOnEdge 0.29.0) declares "game": some vendor performance layers read it to pick a CPU
         governor profile (measured there on OxygenOS: foreground CPU ceiling 1.9/1.65 GHz -> 3.32/3.80 GHz).
         The effect is vendor specific: neutral on stock Android, and Samsung's game service has been
         reported to throttle apps it classifies this way. Since 7.36 the app declares no category: on a
         Galaxy S25 Ultra the "game" app's decode clocks were pinned to ~2 GHz (min = max) after ~6 s of
         load. -PbmoeAppCategory=game (or another category) adds it again from src/appCategory/ for a
         comparison; "undefined" is no valid value, so no category means no attribute. Measure per device. -->
    <application
        android:name=".OnEdgeApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnEdge"
        tools:targetApi="35">

        <!-- Android 12+ (targetSdk 31+) hides vendor libraries from the app's linker namespace unless they are
             declared. ggml-hexagon dlopen()s libcdsprpc.so (Qualcomm FastRPC); without this declaration the load
             fails, the HTP backend never registers and HTP0 is reported as unavailable (devices: CPU).
             required=false keeps the APK installable on devices that do not ship the library. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <!-- OneDrive sign-in: the browser returns here (sync/AuthRedirectActivity.kt, OneDriveAuth.REDIRECT_URI). -->
        <activity
            android:name=".sync.AuthRedirectActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="msal3c225cad-e138-4683-9c03-68001d6609c8" android:host="auth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OnEdge"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share sheet: text, pictures, PDFs and other files go into a chat's message box (ui/share/ShareTarget.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.GenerationForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="on-device AI model inference" />
        </service>

        <service
            android:name=".ui.models.HfDownloadService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="downloading AI model files the user picked" />
        </service>

        <service
            android:name=".server.ApiServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="local API server for on-device AI" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Receives Termux's result for a run_shell command (through the PendingIntent this app hands over). -->
        <receiver
            android:name=".termux.TermuxResultReceiver"
            android:exported="false" />
    </application>

</manifest>
